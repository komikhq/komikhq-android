<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme for Compose (post-splash) -->
    <style name="Theme.KomikHQ" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Light Splash screen theme -->
    <style name="Theme.KomikHQ.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.KomikHQ</item>
    </style>
</resources>
